# Base64 JSON containing publication_url and substack_sid; connect_sid is optional.
SUBSTACK_GATEWAY_TOKEN=
# Numeric Substack user ID used for newsletter draft_bylines. This bypasses the
# legacy global user-settings lookup, which may reject substack.sid-only sessions.
SUBSTACK_AUTOPILOT_WRITER_ID=

# Separate topics with |. A deterministic topic is selected for each schedule slot.
SUBSTACK_AUTOPILOT_TOPICS=artificial intelligence|software engineering|building products
SUBSTACK_AUTOPILOT_CONTEXT=Write in a practical, thoughtful voice for technical founders.
SUBSTACK_AUTOPILOT_TIMEZONE=America/New_York
SUBSTACK_AUTOPILOT_NOTE_INTERVAL_HOURS=3
SUBSTACK_AUTOPILOT_NEWSLETTER_TIME=08:00
SUBSTACK_AUTOPILOT_NOTES_ENABLED=true
SUBSTACK_AUTOPILOT_NEWSLETTERS_ENABLED=true
# Generate image artifacts and attach them to newsletter bodies. Newsletter cover
# images and note image attachments are not supported.
SUBSTACK_AUTOPILOT_IMAGES_ENABLED=false
# Safe default: artifact_only, draft_only, publish_web, or publish_and_email.
SUBSTACK_AUTOPILOT_NEWSLETTER_MODE=draft_only
# Required only for publish_and_email. This can email every subscriber.
# SUBSTACK_AUTOPILOT_EMAIL_CONFIRMATION=SEND_EMAIL_TO_ALL_SUBSCRIBERS
SUBSTACK_AUTOPILOT_POLL_SECONDS=60
SUBSTACK_AUTOPILOT_RETRY_SECONDS=300

# Azure OpenAI text generation (same variable names used by Yapper).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_NAME=

# Required only when SUBSTACK_AUTOPILOT_IMAGES_ENABLED=true.
AZURE_OPENAI_IMAGE_DEPLOYMENT_NAME=
# Supported values depend on the deployed Azure image model and API version.
AZURE_OPENAI_IMAGE_SIZE=1536x1024
# Leave blank to use the deployment default.
AZURE_OPENAI_IMAGE_QUALITY=medium
SUBSTACK_AUTOPILOT_IMAGE_MAX_BYTES=20971520
